# Copy to .env.local for machine-specific overrides (ignored).
DATABASE_URL=postgresql://zstack:zstack@127.0.0.1:5432/zstack

# Alchemy Hyperdrive origin (defaults match Compose). Override for deploy.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=zstack
DATABASE_USER=zstack
DATABASE_PASSWORD=zstack

BETTER_AUTH_URL=http://localhost:3000
# BETTER_AUTH_SECRET belongs in apps/api/.dev.vars for wrangler, or the
# process env / stage secret store for `alchemy deploy` (never commit it).
