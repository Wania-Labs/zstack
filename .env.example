# Who reads which env file (all ignored except .env.development; shell env wins unless noted):
#   .env              Alchemy CLI (`pnpm alchemy:dev` / `alchemy:deploy`) and Docker Compose
#                     interpolation. Alchemy does NOT read .env.local or .env.development;
#                     `alchemy … --env-file <file>` replaces .env and wins over the shell.
#   .env.local        drizzle-kit, `pnpm db:seed`, `pnpm auth:generate` (over .env.development).
#   apps/api/.dev.vars  Worker vars for plain `wrangler dev` (see .dev.vars.example).
# Copy this file to `.env` for Alchemy; put DATABASE_URL overrides in `.env.local`.

# drizzle-kit / db:seed / auth CLI only (.env.development has the committed default).
# Hyperdrive does not read it: wrangler uses `localConnectionString` in
# apps/api/wrangler.jsonc and alchemy:dev uses `composeDevOrigin` in infra/database.ts.
DATABASE_URL=postgresql://zstack:zstack@127.0.0.1:5432/zstack

# Host port for Compose Postgres (compose.yaml defaults to 5432). If you change it, also
# point DATABASE_URL above at it, export
# CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://<user>:<password>@127.0.0.1:<port>/<db>
# for `wrangler dev` / `pnpm test:workers`, and edit `composeDevOrigin.port` in infra/database.ts.
# POSTGRES_PORT=5432

# PlanetScale (Alchemy) — region for new databases; auth via `alchemy login`
PLANETSCALE_REGION=us-east

# Public browser origins. Optional under `alchemy dev` (localhost defaults).
# `alchemy deploy` requires https values (custom domain or workers.dev URL) and
# rejects these localhost ones — keep deploy values in a separate file, e.g.
# `pnpm alchemy:deploy --stage prod --env-file .env.prod`.
BETTER_AUTH_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
# Required by `alchemy:dev` / `alchemy:deploy`: set it here in root .env (or the
# --env-file stage file) or export it (`openssl rand -base64 32`). Plain wrangler
# reads it from apps/api/.dev.vars. Never commit it.
# BETTER_AUTH_SECRET=

# Optional Bento (omit → console EmailService)
# EMAIL_FROM=noreply@your-verified-domain.com
# BENTO_SITE_UUID=
# BENTO_PUBLISHABLE_KEY=
# BENTO_SECRET_KEY=

# Optional Sentry (omit → SDK + evlog Sentry drain stay off)
# Create separate projects for api / web / admin in your Sentry org.
# SENTRY_DSN=                    # apps/api Worker
# VITE_SENTRY_DSN_WEB=           # apps/web (Alchemy) → VITE_SENTRY_DSN
# VITE_SENTRY_DSN_ADMIN=         # apps/admin (Alchemy) → VITE_SENTRY_DSN
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1            # web + admin; "0" turns tracing off
# VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1   # web + admin; "0" turns replays off
# SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0.1   # 0–1; "0" turns tracing off

# Optional Polar (omit → FakeBillingLive)
# POLAR_ACCESS_TOKEN=
# POLAR_WEBHOOK_SECRET=
# POLAR_PRODUCT_PRO=

# Optional PostHog (omit → no-op analytics). Do not enable PostHog flags.
# POSTHOG_API_KEY=
# VITE_PUBLIC_POSTHOG_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
# VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional R2 S3 API tokens for presigned URLs (omit → Worker /api/objects/*)
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
