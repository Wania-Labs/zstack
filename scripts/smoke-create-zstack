#!/usr/bin/env bash
# Generate consumer clones from committed HEAD and check them.
#
# Full variants run the steps of the clone's own ci.yml
# (install --frozen-lockfile, typecheck, lint, format:check, test, test:workers,
# build, drizzle-kit check + generate guard):
#   acme         --name "Acme Cloud" --scope @acme
#   my-product   default identity from the directory + --agent-tools=all
#   zstack-demo  default identity whose name contains "zstack"
#   short        shortest identity: --name A (slug a, scope @a)
#   max          longest identity: 32-column name, 32-char scope, --agent-tools=all
#
# Quick variants (no install; format:check with this repo's oxfmt):
#   wide         32-column name with East Asian wide characters
#   punct        name using every allowed punctuation character
#   force        --force into an existing dir; the user's docs/.cursor/repos survive
#
# Select a subset with ZSTACK_SMOKE_VARIANTS="acme force".
# ZSTACK_SMOKE_DIR sets the parent directory for the clones (default: mktemp,
# removed on exit unless ZSTACK_SMOKE_KEEP=1).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ -n "${ZSTACK_SMOKE_DIR:-}" ]]; then
  BASE="$ZSTACK_SMOKE_DIR"
  if [[ "$BASE" != /* ]]; then
    BASE="$(pwd)/$BASE"
  fi
  mkdir -p "$BASE"
else
  BASE="$(mktemp -d /tmp/zstack-smoke.XXXXXX)"
  if [[ "${ZSTACK_SMOKE_KEEP:-}" != "1" ]]; then
    trap 'rm -rf "$BASE"' EXIT
  fi
fi

if [[ -n "$(git -C "$ROOT" status --porcelain)" ]]; then
  echo "warning: uncommitted changes in $ROOT; giget git: only sees committed HEAD" >&2
fi

VARIANTS="${ZSTACK_SMOKE_VARIANTS:-acme my-product zstack-demo short max wide punct force}"
OXFMT="$ROOT/node_modules/.bin/oxfmt"
MAX_NAME="Abcdefghij Klmnopqrst Uvwxyzabcd"
MAX_SCOPE="abcdefghijabcdefghijabcdefghijab"
WIDE_NAME="A 漢字漢字漢字漢字漢字漢字漢字漢"
PUNCT_NAME="O'Brien & Co. Built-In 2"

echo "BASE=$BASE"

die() {
  echo "$1" >&2
  exit 1
}

require_file() {
  [[ -f "$1" ]] || die "expected file is missing: $1"
}

assert_clone_shape() {
  local dest="$1"

  for authoring in create-zstack docs tech-stack-architecture-guide repos agent-transcripts .audit \
    AUTHORING.md .cursor/skills/verify-zstack .cursor/skills/release-create-zstack \
    scripts/smoke-create-zstack .github/workflows/docs.yml \
    .github/workflows/generate-clone.yml .github/workflows/publish-create-zstack.yml; do
    if [[ -e "$dest/$authoring" ]]; then
      die "clone still contains authoring path: $authoring"
    fi
  done

  for file in pnpm-workspace.yaml .oxlintrc.json .oxfmtrc.json .github/workflows/ci.yml \
    product.config.ts; do
    require_file "$dest/$file"
  done

  if grep -qE '^[[:space:]]*-[[:space:]]*"create-zstack"' "$dest/pnpm-workspace.yaml"; then
    die "pnpm-workspace.yaml still lists create-zstack"
  fi

  if grep -qE 'docs/\*\*|tech-stack-architecture-guide' "$dest/.oxlintrc.json" "$dest/.oxfmtrc.json" \
    "$dest/.github/workflows/ci.yml"; then
    die "clone configs still reference authoring paths"
  fi

  if grep -q 'AUTHORING' "$dest/product.config.ts"; then
    die "product.config.ts still references AUTHORING.md"
  fi
}

assert_personalized() {
  local dest="$1"
  while IFS= read -r pkg; do
    if grep -qE '"name"[[:space:]]*:[[:space:]]*"zstack"' "$pkg"; then
      die "clone package.json still named zstack: $pkg"
    fi
    if grep -qE '"name"[[:space:]]*:[[:space:]]*"@zstack/' "$pkg"; then
      die "clone workspace packages still use @zstack: $pkg"
    fi
  done < <(find "$dest" -name package.json -not -path '*/node_modules/*')
}

run_clone_ci() {
  local dest="$1"
  (
    cd "$dest"
    pnpm install --frozen-lockfile
    pnpm typecheck
    pnpm lint
    pnpm format:check
    pnpm test
    pnpm test:workers
    pnpm build
    pnpm --filter ./apps/api exec drizzle-kit check
    # Mirror ci.yml's "no ungenerated migration" guard without needing a git repo.
    local before after
    before="$(find apps/api/drizzle -type f -exec shasum {} + | sort)"
    pnpm --filter ./apps/api exec drizzle-kit generate
    after="$(find apps/api/drizzle -type f -exec shasum {} + | sort)"
    if [[ "$before" != "$after" ]]; then
      die "drizzle-kit generate produced a migration in the clone"
    fi
  )
}

create_clone() {
  local dest="$1"
  shift
  echo
  echo "==> create-zstack $dest $*"
  (cd "$ROOT" && ZSTACK_TEMPLATE="git:$ROOT" pnpm run create-zstack "$dest" --yes --no-install "$@")
}

run_variant() {
  local dest="$1"
  shift
  rm -rf "$dest"
  create_clone "$dest" "$@"
  assert_clone_shape "$dest"
  assert_personalized "$dest"
  run_clone_ci "$dest"
  echo "==> ok: $dest"
}

run_format_variant() {
  local dest="$1"
  shift
  rm -rf "$dest"
  create_clone "$dest" "$@"
  assert_clone_shape "$dest"
  assert_personalized "$dest"
  (cd "$dest" && "$OXFMT" --check .)
  echo "==> ok (format): $dest"
}

run_force_variant() {
  local dest="$1"
  rm -rf "$dest"
  mkdir -p "$dest/docs" "$dest/.cursor/rules" "$dest/repos/mylib"
  echo "# Design" >"$dest/docs/design.md"
  echo "mine" >"$dest/.cursor/rules/mine.mdc"
  echo "a" >"$dest/repos/mylib/a.txt"
  create_clone "$dest" --name "Acme Cloud" --scope @acme --force
  require_file "$dest/docs/design.md"
  require_file "$dest/.cursor/rules/mine.mdc"
  require_file "$dest/repos/mylib/a.txt"
  if [[ -e "$dest/create-zstack" || -e "$dest/docs/content" ]]; then
    die "force clone still contains authoring paths"
  fi
  assert_personalized "$dest"
  echo "==> ok (force): $dest"
}

for variant in $VARIANTS; do
  case "$variant" in
    acme)
      run_variant "$BASE/acme" --name "Acme Cloud" --scope @acme
      grep -q '"name": "acme-cloud"' "$BASE/acme/package.json"
      ;;
    my-product)
      run_variant "$BASE/my-product" --agent-tools=all
      grep -q '"name": "@my-product/api"' "$BASE/my-product/apps/api/package.json"
      require_file "$BASE/my-product/CLAUDE.md"
      require_file "$BASE/my-product/.cursor/rules/my-product.mdc"
      ;;
    zstack-demo)
      run_variant "$BASE/zstack-demo"
      grep -q '"name": "@zstack-demo/api"' "$BASE/zstack-demo/apps/api/package.json"
      ;;
    short)
      run_variant "$BASE/short" --name A
      grep -q '"name": "@a/api"' "$BASE/short/apps/api/package.json"
      ;;
    max)
      run_variant "$BASE/max" --name "$MAX_NAME" --scope "$MAX_SCOPE" --agent-tools=all
      grep -q "\"name\": \"@$MAX_SCOPE/api\"" "$BASE/max/apps/api/package.json"
      ;;
    wide)
      run_format_variant "$BASE/wide" --name "$WIDE_NAME" --scope wide
      ;;
    punct)
      run_format_variant "$BASE/punct" --name "$PUNCT_NAME"
      ;;
    force)
      run_force_variant "$BASE/force"
      ;;
    *)
      die "unknown smoke variant: $variant"
      ;;
  esac
done

echo
echo "All smoke variants passed: $VARIANTS"
