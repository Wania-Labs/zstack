{
  "name": "@zstack/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:up": "drizzle-kit up",
    "db:seed": "tsx scripts/seed.ts",
    "auth:generate": "auth generate --config ./auth.cli.ts --output ./src/platform/db/auth-schema.ts --yes",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.evals.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:evals": "vitest run --config vitest.evals.config.ts",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.46",
    "@effect/sql-pg": "4.0.0-rc.108",
    "@orpc/client": "1.15.0",
    "@orpc/server": "1.15.0",
    "@sentry/cloudflare": "10.69.0",
    "@sentry/hono": "10.69.0",
    "@zstack/auth-access": "workspace:*",
    "@zstack/contracts": "workspace:*",
    "@zstack/email": "workspace:*",
    "ai": "^7.0.58",
    "better-auth": "1.6.26",
    "dotenv": "17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "4.0.0-rc.108",
    "evlog": "2.25.0",
    "hono": "^4.13.1",
    "pg": "8.23.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@cloudflare/workers-types": "^4.20250803.0",
    "@effect/vitest": "4.0.0-rc.108",
    "@types/node": "22.19.1",
    "@types/pg": "8.15.5",
    "@vitest-evals/harness-ai-sdk": "^0.16.1",
    "@zstack/typescript-config": "workspace:*",
    "auth": "1.6.26",
    "drizzle-kit": "1.0.0-rc.4",
    "tsx": "4.23.11",
    "typescript": "7.0.2",
    "vitest": "^4.1.10",
    "vitest-evals": "^0.16.1",
    "wrangler": "^4.110.0"
  }
}
