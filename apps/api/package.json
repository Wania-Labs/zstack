{
  "name": "@zstack/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:up": "drizzle-kit up",
    "db:seed": "tsx scripts/seed.ts",
    "auth:generate": "auth generate --config ./auth.cli.ts --output ./src/platform/db/auth-schema.ts --yes",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.evals.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:evals": "vitest run --config vitest.evals.config.ts",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.103",
    "@effect/sql-pg": "4.0.0",
    "@orpc/client": "1.15.4",
    "@orpc/server": "1.15.4",
    "@polar-sh/sdk": "1.0.2",
    "@sentry/cloudflare": "11.3.0",
    "@sentry/hono": "11.3.0",
    "@zstack/analytics": "workspace:*",
    "@zstack/auth-access": "workspace:*",
    "@zstack/contracts": "workspace:*",
    "@zstack/email": "workspace:*",
    "ai": "^7.0.127",
    "aws4fetch": "^1.0.20",
    "better-auth": "1.7.7",
    "dotenv": "18.0.5",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "4.0.0",
    "evlog": "2.29.0",
    "hono": "^4.13.12",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261002.1",
    "@effect/vitest": "4.0.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@vitest-evals/harness-ai-sdk": "^0.17.0",
    "@zstack/typescript-config": "workspace:*",
    "auth": "1.7.7",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "^4.1.11",
    "vitest-evals": "^0.17.0",
    "wrangler": "^4.147.0"
  }
}
