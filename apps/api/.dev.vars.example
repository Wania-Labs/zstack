BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-me-run-openssl-rand-or-auth-secret

# Optional Bento transport (omit → console EmailService)
# EMAIL_FROM=noreply@your-verified-domain.com
# BENTO_SITE_UUID=
# BENTO_PUBLISHABLE_KEY=
# BENTO_SECRET_KEY=

# Optional Sentry (omit → errors/traces/logs stay local-only)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=1

# Optional Vercel AI Gateway (omit → deterministic fake models, no spend)
# AI_GATEWAY_API_KEY=
