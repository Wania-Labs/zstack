BETTER_AUTH_URL=http://localhost:3000
# Staff console origin (Better Auth trustedOrigins). Localhost dev ports are
# only trusted while BETTER_AUTH_URL is http://localhost.
ADMIN_URL=http://localhost:3001
BETTER_AUTH_SECRET=replace-me-run-openssl-rand-or-auth-secret

# Optional Bento transport (omit → console EmailService)
# EMAIL_FROM=noreply@your-verified-domain.com
# BENTO_SITE_UUID=
# BENTO_PUBLISHABLE_KEY=
# BENTO_SECRET_KEY=

# Optional Sentry (omit → errors/traces/logs stay local-only)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Optional Vercel AI Gateway (omit → deterministic fake models, no spend)
# AI_GATEWAY_API_KEY=

# Object storage is a Worker R2 binding (OBJECTS), not a secret.
# alchemy:dev binds Alchemy local R2. wrangler without the binding uses the in-memory fake.

# Queues and workflows are Worker bindings (JOBS, EXAMPLE_WORKFLOW), not secrets.
# alchemy:dev binds a local queue + the example Cloudflare Workflow. Missing bindings use in-memory fakes.

# Optional in-memory flag overlays (FEATURE_FLAG_<KEY>=value → key with dots)
# Any key works under wrangler; under Alchemy add each new key to infra/api.ts `env`.
# FEATURE_FLAG_EXAMPLE_READY=true

# Optional Polar billing (omit → FakeBillingLive, checkout/portal unconfigured)
# POLAR_ACCESS_TOKEN=
# POLAR_SERVER=sandbox
# POLAR_CHECKOUT_SUCCESS_URL=
# POLAR_WEBHOOK_SECRET=
# Product catalog: POLAR_PRODUCT_<SLUG_UPPERCASE>=<product_id>
# Any slug works under wrangler; under Alchemy add each new key to infra/api.ts `env`.
# POLAR_PRODUCT_PRO=
# POLAR_PRODUCT_ENTERPRISE=

# Optional PostHog product analytics (omit → no-op). Do not enable PostHog flags.
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com

# R2 S3 API tokens for presigned object URLs: effectively Alchemy-only.
# Plain wrangler has no OBJECTS binding (wrangler.jsonc declares no R2), so the
# in-memory fake store is used and these do nothing on their own. Presign needs all
# four of R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, CLOUDFLARE_ACCOUNT_ID, and
# OBJECTS_BUCKET_NAME; Alchemy binds the last two from the R2 bucket. For Alchemy,
# set the tokens in the root .env (or shell), not here.
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
