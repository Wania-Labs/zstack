{
  "name": "@wanialabs/create-zstack",
  "version": "0.1.0",
  "description": "Scaffold a product from the zstack template (giget + nypm).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wania-Labs/zstack.git",
    "directory": "create-zstack"
  },
  "homepage": "https://github.com/Wania-Labs/zstack/tree/main/create-zstack",
  "bugs": {
    "url": "https://github.com/Wania-Labs/zstack/issues"
  },
  "keywords": [
    "zstack",
    "create",
    "scaffold",
    "cloudflare",
    "effect",
    "tanstack"
  ],
  "bin": {
    "create-zstack": "./bin/create-zstack.mjs"
  },
  "type": "module",
  "files": [
    "bin",
    "dist",
    "packs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "start": "tsx src/cli.ts",
    "prepublishOnly": "pnpm run build && pnpm test && pnpm typecheck",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "citty": "^0.2.2",
    "giget": "^3.3.1",
    "nypm": "^0.6.9"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@zstack/typescript-config": "workspace:*",
    "tsx": "4.23.11",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
