{
  "name": "zstack",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:services": "docker compose up -d --wait",
    "dev:down": "docker compose down",
    "dev:reset": "docker compose down -v && docker compose up -d --wait && pnpm db:migrate && pnpm db:seed",
    "db:generate": "pnpm --filter @zstack/api db:generate",
    "db:migrate": "pnpm --filter @zstack/api db:migrate",
    "db:seed": "pnpm --filter @zstack/api db:seed",
    "auth:generate": "pnpm --filter @zstack/api auth:generate",
    "email:dev": "pnpm --filter @zstack/email dev",
    "alchemy:dev": "alchemy dev",
    "alchemy:deploy": "alchemy deploy",
    "alchemy:destroy": "alchemy destroy",
    "lint": "oxlint --no-error-on-unmatched-pattern --disable-nested-config .",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.alchemy.json",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "turbo run test",
    "test:evals": "pnpm --filter @zstack/api test:evals",
    "test:workers": "pnpm --filter @zstack/api test:workers",
    "create-zstack": "pnpm --filter @wanialabs/create-zstack start",
    "smoke:create": "bash scripts/smoke-create-zstack",
    "agent:vendor-effect": "node scripts/vendor-effect.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "@effect/platform-node": "4.0.0",
    "@types/node": "22.20.5",
    "alchemy": "2.0.0-beta.80",
    "effect": "4.0.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "turbo": "^2.11.7",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.18.0"
}
